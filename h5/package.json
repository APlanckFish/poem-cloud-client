{
  "name": "poem-cloud-h5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "styles:sync": "node scripts/import-miniprogram-less.mjs",
    "assets:verify": "node scripts/verify-miniprogram-assets.mjs",
    "dev": "vite",
    "build": "pnpm assets:verify && pnpm styles:sync && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "less": "^4.8.1",
    "typescript": "latest",
    "vite": "latest"
  }
}
