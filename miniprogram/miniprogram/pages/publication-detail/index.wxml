<view class="app-viewport detail-viewport">
<navigation-bar
  wx:if="{{!isTimelineSinglePage}}"
  title="作品详情"
  back="{{true}}"
  custom-back="{{true}}"
  bindback="handleBack"
  color="#202824"
  background="{{notFound ? '#f6f4f2' : '#fffefa'}}"
></navigation-bar>

<scroll-view class="detail-scroll" scroll-y enhanced bounces="{{false}}" refresher-enabled="{{false}}" show-scrollbar="{{false}}">
  <view wx:if="{{publication}}" class="detail-page {{isTimelineSinglePage ? 'detail-page--single-page' : ''}}">
    <view class="detail-card-scene" style="height: {{cardHeightRpx}}rpx;">
      <view
        class="detail-flip-card {{isCardFlipped ? 'detail-flip-card--back' : ''}} {{isCardHinting ? 'detail-flip-card--hinting' : ''}}"
        bindanimationend="handleCardHintEnd"
      >
        <view
          class="detail-paper detail-card-face detail-card-front"
          bindtap="toggleCreationCard"
          aria-role="{{canViewCreationJourney ? 'button' : ''}}"
          aria-label="{{canViewCreationJourney ? '翻看创作手记' : ''}}"
        >
          <view class="detail-paper__scene">
            <image class="detail-paper__scene-image" src="{{coverUrl}}" mode="aspectFill"></image>
            <view class="detail-paper__scene-fade"></view>
          </view>

          <text class="detail-title poem-display">{{publication.title}}</text>
          <view class="detail-badges">
            <view class="detail-type poem-display">{{categoryName}}</view>
            <button
              wx:if="{{isOwner && publication.status === 'REJECTED'}}"
              class="native-button-reset detail-status detail-status--rejected poem-display"
              catchtap="showModerationReason"
              aria-label="查看作品下架原因"
            >
              <text>已下架</text>
              <text class="detail-status__notice">!</text>
            </button>
          </view>

          <view class="detail-author">
            <view class="detail-author__avatar poem-display">
              <image
                wx:if="{{publication.author.avatarUrl}}"
                src="{{publication.author.avatarUrl}}"
                mode="aspectFill"
              ></image>
              <text wx:else>{{authorInitial}}</text>
            </view>
            <view class="detail-author__copy">
              <text class="detail-author__name poem-display">{{publication.author.nickname}}</text>
              <text
                wx:if="{{publishedDate}}"
                class="detail-author__date"
              >{{publishedDate}}</text>
            </view>
          </view>

          <text class="detail-content poem-display" user-select><text
            wx:for="{{publicationContentRuns}}"
            wx:key="index"
            class="{{item.invalid ? 'detail-content__validation-error' : ''}}"
          >{{item.text}}</text></text>
        </view>

        <view class="detail-card-face detail-journal">
          <view
            class="detail-journal__header"
            bindtap="toggleCreationCard"
            aria-role="button"
            aria-label="翻回诗词正文"
          >
            <text class="detail-journal__title poem-display">创作手记</text>
            <text class="detail-journal__subtitle poem-display">从一束光影，到一首诗</text>
          </view>

          <scroll-view
            class="detail-journal__scroll"
            scroll-y
            enhanced
            bounces="{{false}}"
            show-scrollbar="{{false}}"
            bindtap="toggleCreationCard"
          >
            <view wx:if="{{isJourneyLoading}}" class="detail-journal__state poem-display">
              正在展开创作脉络…
            </view>
            <view wx:elif="{{journeyError}}" class="detail-journal__state detail-journal__state--error poem-display">
              {{journeyError}}
            </view>
            <view wx:else class="detail-timeline">
              <view wx:if="{{publication.materials.length > 0}}" class="detail-materials">
                <view class="detail-timeline__rail">
                  <view class="detail-timeline__node"></view>
                  <view class="detail-timeline__line"></view>
                </view>
                <view class="detail-materials__body">
                  <text class="detail-timeline__label poem-display">查看原始素材</text>
                  <text class="detail-timeline__description">创作这首诗时使用的图片与视频</text>
                  <scroll-view
                    class="detail-materials__scroll"
                    scroll-x
                    enhanced
                    bounces="{{false}}"
                    show-scrollbar="{{false}}"
                  >
                    <view class="detail-materials__list">
                      <view
                        wx:for="{{publication.materials}}"
                        wx:key="id"
                        class="detail-materials__item"
                        data-id="{{item.id}}"
                        catchtap="previewOriginalMaterial"
                        aria-role="button"
                        aria-label="全屏查看原始素材"
                      >
                        <image
                          class="detail-materials__image"
                          src="{{item.thumbnailUrl || item.url}}"
                          mode="aspectFill"
                        ></image>
                        <view wx:if="{{item.kind === 'VIDEO'}}" class="detail-materials__video">
                          <view class="detail-materials__play"></view>
                        </view>
                      </view>
                    </view>
                  </scroll-view>
                </view>
              </view>
              <view wx:if="{{journeyPrompt}}" class="detail-original-prompt">
                <view class="detail-timeline__rail">
                  <view class="detail-timeline__node"></view>
                  <view class="detail-timeline__line"></view>
                </view>
                <view class="detail-original-prompt__body">
                  <text class="detail-timeline__label poem-display">原始文字要求</text>
                  <text class="detail-timeline__description">创作这首诗时写下的内容</text>
                  <text
                    class="detail-original-prompt__content poem-display"
                    user-select
                    catchtap="preventCardFlip"
                  >{{journeyPrompt}}</text>
                </view>
              </view>
              <view
                wx:for="{{journeyMoments}}"
                wx:key="id"
                class="detail-timeline__moment {{index === journeyMoments.length - 1 ? 'detail-timeline__moment--last' : ''}}"
              >
                <view class="detail-timeline__rail">
                  <view class="detail-timeline__node"></view>
                  <view class="detail-timeline__line"></view>
                </view>
                <view class="detail-timeline__body">
                  <view class="detail-timeline__heading">
                    <view>
                      <text class="detail-timeline__label poem-display">{{item.label}}</text>
                      <text class="detail-timeline__description">{{item.description}}</text>
                    </view>
                    <text wx:if="{{item.time}}" class="detail-timeline__time">{{item.time}}</text>
                  </view>
                  <view class="detail-timeline__notes">
                    <view
                      wx:for="{{item.entries}}"
                      wx:for-item="entry"
                      wx:key="*this"
                      class="detail-timeline__note"
                    >
                      <text class="detail-timeline__note-mark">·</text>
                      <text>{{entry}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <button
      wx:if="{{isPublic}}"
      class="native-button-reset detail-action detail-action--like {{publication.likedByMe ? 'detail-action--liked' : ''}}"
      bindtap="toggleLike"
    >
      <view class="detail-like__summary">
        <view class="like-anchor">
          <image
            class="heart-icon {{showLikeBurst ? 'heart-icon--pop' : ''}}"
            src="{{publication.likedByMe ? '/assets/icons/heart-filled.png' : '/assets/icons/heart-outline.png'}}"
            mode="aspectFit"
          ></image>
          <view wx:if="{{showLikeBurst}}" class="like-burst">
            <view class="like-burst__ring"></view>
            <view class="like-burst__particle like-burst__particle--1"></view>
            <view class="like-burst__particle like-burst__particle--2"></view>
            <view class="like-burst__particle like-burst__particle--3"></view>
            <view class="like-burst__particle like-burst__particle--4"></view>
            <view class="like-burst__particle like-burst__particle--5"></view>
            <view class="like-burst__particle like-burst__particle--6"></view>
          </view>
        </view>
        <text class="detail-like-count">{{publication.likeCount}}</text>
      </view>
      <view class="detail-like__state">{{publication.likedByMe ? '已点赞' : '点赞'}}</view>
    </button>

    <view wx:if="{{canManagePublication}}" class="detail-display-settings">
      <view class="detail-setting-row">
        <text class="detail-setting-row__label poem-display">公开创作手记</text>
        <switch
          class="detail-setting-row__switch"
          checked="{{creationJournalPublic}}"
          disabled="{{isUpdatingSettings}}"
          color="#3f6758"
          bindchange="handleJournalVisibilityChange"
        />
      </view>
      <view class="detail-setting-row">
        <text class="detail-setting-row__label poem-display">卡片背景</text>
        <view class="detail-cover-choice">
          <view
            class="detail-cover-choice__item poem-display {{coverSource === 'MATERIAL' ? 'detail-cover-choice__item--active' : ''}} {{!materialBackgroundReady ? 'detail-cover-choice__item--disabled' : ''}}"
            data-source="MATERIAL"
            bindtap="selectCoverSource"
            aria-role="button"
          >原始素材</view>
          <view
            class="detail-cover-choice__item poem-display {{coverSource === 'POSTER' ? 'detail-cover-choice__item--active' : ''}} {{!posterBackgroundReady ? 'detail-cover-choice__item--disabled' : ''}}"
            data-source="POSTER"
            bindtap="selectCoverSource"
            aria-role="button"
          >海报图</view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{showDetailActions}}"
      class="detail-actions"
    >
      <view wx:if="{{!isPublic}}" class="detail-actions__secondary">
        <button
          class="native-button-reset native-button-reset--flex detail-action detail-action--save {{!posterReady && !posterBackgroundReady ? 'detail-action--disabled' : ''}}"
          disabled="{{(!posterReady && !posterBackgroundReady) || isSavingPoster}}"
          bindtap="savePosterToAlbum"
        >
          <image
            class="detail-action__download-icon"
            src="/assets/icons/action-download.svg"
            mode="aspectFit"
          ></image>
          <text>{{isSavingPoster ? '正在保存' : '保存到手机'}}</text>
        </button>
        <button
          class="native-button-reset native-button-reset--flex detail-action detail-action--private-share {{publication.status === 'REJECTED' || isPreparingPrivateShare ? 'detail-action--disabled' : ''}}"
          disabled="{{publication.status === 'REJECTED' || isPreparingPrivateShare}}"
          bindtap="preparePrivateShare"
        >
          <image
            class="detail-action__share-icon"
            src="/assets/icons/action-share-v2.png"
            mode="aspectFit"
          ></image>
          <text>{{publication.status === 'REJECTED' ? '作品不可分享' : isPreparingPrivateShare ? '准备分享中' : '分享作品'}}</text>
        </button>
      </view>
      <button
        wx:if="{{isPublic}}"
        class="native-button-reset native-button-reset--block detail-action detail-action--share"
        bindtap="showShareSheet"
      >
        <image class="detail-action__share-icon" src="/assets/icons/action-share-v2.png" mode="aspectFit"></image>
        <text>分享作品</text>
      </button>
      <button
        wx:if="{{canPublish}}"
        class="native-button-reset native-button-reset--block detail-action detail-action--publish"
        disabled="{{isPublishing}}"
        bindtap="publishToCommunity"
      >
        <image src="/assets/icons/result-publish.png" mode="aspectFit"></image>
        <text>{{isPublishing ? '正在发布' : '发布到诗词圈'}}</text>
      </button>
      <view
        wx:if="{{isPublic && canFollow}}"
        class="detail-action detail-action--follow {{followedByMe ? 'detail-action--followed' : ''}}"
        bindtap="toggleFollow"
        aria-role="button"
        aria-label="{{followedByMe ? '取消关注作者' : '关注作者'}}"
      >
        <image
          src="{{followedByMe ? '/assets/icons/action-followed-v2.png' : '/assets/icons/action-follow-add-v2.png'}}"
          mode="aspectFit"
        ></image>
        <text>{{followedByMe ? '已关注' : '关注作者'}}</text>
      </view>
    </view>

    <view wx:if="{{isPublic}}" class="detail-comments">
      <view class="detail-comments__header">
        <text class="detail-comments__title poem-display">评论</text>
        <text class="detail-comments__count">共 {{publication.commentCount}} 条</text>
      </view>

      <view class="detail-comment-composer {{commentInputFocused ? 'detail-comment-composer--focused' : ''}}">
        <view wx:if="{{replyingTo}}" class="detail-comment-composer__replying">
          <text>回复 {{replyingTo.nickname}}</text>
          <button
            class="native-button-reset detail-comment-composer__cancel"
            bindtap="cancelCommentReply"
            aria-label="取消回复"
          >取消</button>
        </view>
        <view wx:if="{{canComment}}" class="detail-comment-composer__row">
          <textarea
            wx:if="{{!shareSheetVisible && !posterPreviewVisible}}"
            class="detail-comment-composer__input poem-display"
            value="{{commentDraft}}"
            maxlength="300"
            auto-height
            fixed
            show-confirm-bar="{{false}}"
            cursor-spacing="24"
            focus="{{commentInputFocused}}"
            placeholder="{{replyingTo ? '回复 ' + replyingTo.nickname + '…' : '写下此刻的感受…'}}"
            bindinput="handleCommentInput"
            bindfocus="handleCommentInputFocus"
            bindblur="handleCommentInputBlur"
          ></textarea>
          <button
            class="native-button-reset detail-comment-composer__send {{!commentDraft || isSubmittingComment ? 'detail-comment-composer__send--disabled' : ''}}"
            disabled="{{!commentDraft || isSubmittingComment}}"
            bindtap="submitComment"
          >{{isSubmittingComment ? '发送中' : '发送'}}</button>
        </view>
        <button
          wx:else
          class="native-button-reset native-button-reset--block detail-comment-composer__login poem-display"
          bindtap="activateCommentComposer"
        >登录后写下评论</button>
      </view>

      <view wx:if="{{isCommentsLoading}}" class="detail-comments-loading" aria-label="评论加载中">
        <view class="detail-comments-loading__avatar"></view>
        <view class="detail-comments-loading__body">
          <view class="detail-comments-loading__line detail-comments-loading__line--short"></view>
          <view class="detail-comments-loading__line"></view>
          <view class="detail-comments-loading__line detail-comments-loading__line--medium"></view>
        </view>
      </view>

      <view wx:elif="{{commentsError}}" class="detail-comments-state">
        <text class="detail-comments-state__text poem-display">{{commentsError}}</text>
        <button
          class="native-button-reset detail-comments-state__action poem-display"
          bindtap="retryComments"
        >重新加载</button>
      </view>

      <view wx:elif="{{commentsLoaded && comments.length === 0}}" class="detail-comments-state detail-comments-state--empty">
        <text class="detail-comments-state__text poem-display">还没有评论，写下第一句共鸣</text>
      </view>

      <view wx:else class="detail-comment-list">
        <view wx:for="{{comments}}" wx:key="id" class="detail-comment-item">
          <view class="detail-comment-item__avatar poem-display">
            <image
              wx:if="{{item.author.avatarUrl}}"
              src="{{item.author.avatarUrl}}"
              mode="aspectFill"
            ></image>
            <text wx:else>{{item.avatarInitial}}</text>
          </view>
          <view class="detail-comment-item__body">
            <view class="detail-comment-item__meta">
              <view class="detail-comment-item__identity">
                <text class="detail-comment-item__name poem-display">{{item.author.nickname}}</text>
                <text wx:if="{{item.isPublicationAuthor}}" class="detail-comment-item__author-tag poem-display">作者</text>
              </view>
              <text class="detail-comment-item__time">{{item.displayTime}}</text>
            </view>
            <text class="detail-comment-item__content poem-display" user-select>{{item.content}}</text>
            <view class="detail-comment-item__actions">
              <button
                class="native-button-reset detail-comment-item__action poem-display"
                data-id="{{item.id}}"
                data-nickname="{{item.author.nickname}}"
                bindtap="beginCommentReply"
              >回复</button>
              <button
                wx:if="{{item.canDelete}}"
                class="native-button-reset detail-comment-item__action detail-comment-item__action--delete poem-display"
                data-id="{{item.id}}"
                data-root-comment-id="{{item.id}}"
                disabled="{{deletingCommentIds.length > 0}}"
                bindtap="deleteComment"
              >{{deletingCommentIds[0] === item.id ? '删除中' : '删除'}}</button>
            </view>

            <view wx:if="{{item.replies.length > 0}}" class="detail-comment-replies">
              <view
                wx:for="{{item.replies}}"
                wx:for-item="reply"
                wx:key="id"
                class="detail-comment-reply"
              >
                <view class="detail-comment-reply__line poem-display">
                  <text class="detail-comment-reply__name">{{reply.author.nickname}}</text>
                  <text wx:if="{{reply.isPublicationAuthor}}" class="detail-comment-item__author-tag">作者</text>
                  <text wx:if="{{reply.replyToUser}}" class="detail-comment-reply__target"> 回复 {{reply.replyToUser.nickname}}</text>
                  <text>：{{reply.content}}</text>
                </view>
                <view class="detail-comment-reply__meta">
                  <text class="detail-comment-item__time">{{reply.displayTime}}</text>
                  <button
                    class="native-button-reset detail-comment-item__action poem-display"
                    data-id="{{reply.id}}"
                    data-root-comment-id="{{item.id}}"
                    data-nickname="{{reply.author.nickname}}"
                    bindtap="beginCommentReply"
                  >回复</button>
                  <button
                    wx:if="{{reply.canDelete}}"
                    class="native-button-reset detail-comment-item__action detail-comment-item__action--delete poem-display"
                    data-id="{{reply.id}}"
                    data-root-comment-id="{{item.id}}"
                    disabled="{{deletingCommentIds.length > 0}}"
                    bindtap="deleteComment"
                  >{{deletingCommentIds[0] === reply.id ? '删除中' : '删除'}}</button>
                </view>
              </view>
            </view>

            <view class="detail-comment-replies__more">
              <text wx:if="{{item.isRepliesLoading}}" class="detail-comment-replies__loading poem-display">正在展开回复…</text>
              <button
                wx:elif="{{item.hasMoreReplies && !item.repliesExpanded}}"
                class="native-button-reset detail-comment-replies__button poem-display"
                data-id="{{item.id}}"
                bindtap="expandCommentReplies"
              >展开全部 {{item.replyCount}} 条回复</button>
              <button
                wx:elif="{{item.repliesNextCursor}}"
                class="native-button-reset detail-comment-replies__button poem-display"
                data-id="{{item.id}}"
                bindtap="loadMoreCommentReplies"
              >加载更多回复</button>
            </view>
          </view>
        </view>

        <button
          wx:if="{{commentsNextCursor}}"
          class="native-button-reset native-button-reset--block detail-comments-more poem-display"
          disabled="{{isCommentsLoadingMore}}"
          bindtap="loadMoreComments"
        >{{isCommentsLoadingMore ? '正在加载更多评论…' : '查看更多评论'}}</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{isLoading}}" class="detail-empty poem-display">正在展开诗笺…</view>
  <view wx:elif="{{notFound}}" class="publication-unavailable">
    <image
      class="publication-unavailable__illustration"
      src="/assets/images/empty-works.jpg"
      mode="aspectFit"
    ></image>
    <text class="publication-unavailable__title poem-display">暂无作品</text>
    <text class="publication-unavailable__copy">这篇作品暂时无法查看</text>
    <view
      class="publication-unavailable__action poem-display"
      bindtap="goToCommunity"
      aria-role="button"
      aria-label="去诗词圈看看"
    >去诗词圈看看</view>
    <image
      class="publication-unavailable__mountain"
      src="/assets/images/mountain-wash.jpg"
      mode="widthFix"
    ></image>
  </view>
  <view wx:else class="detail-empty poem-display">这首诗暂时无法查看</view>
</scroll-view>

<view wx:if="{{shareSheetVisible && !isTimelineSinglePage}}" class="share-layer" catchtap="closeShareSheet">
  <view class="share-sheet" catchtap="stopShareTap">
    <view class="share-sheet__handle"></view>
    <view class="share-sheet__header">
      <text class="share-sheet__title poem-display">分享至</text>
      <button class="native-button-reset share-sheet__close" bindtap="closeShareSheet" aria-label="关闭">×</button>
    </view>
    <view class="share-sheet__actions">
      <button wx:if="{{friendShareReady}}" class="native-button-reset share-sheet__action" open-type="share">
        <image src="/assets/icons/share-friend-ref.png" mode="aspectFit"></image>
        <text>微信好友/群聊</text>
      </button>
      <button
        wx:else
        class="native-button-reset share-sheet__action share-sheet__action--unavailable"
        disabled="{{isPreparingFriendShare}}"
        bindtap="retryFriendSharePreparation"
        aria-label="{{isPreparingFriendShare ? '好友和群聊分享准备中' : '重新准备好友和群聊分享'}}"
      >
        <image src="/assets/icons/share-friend-ref.png" mode="aspectFit"></image>
        <text>{{isPreparingFriendShare ? '好友/群聊准备中' : '微信好友/群聊'}}</text>
      </button>
      <button
        class="native-button-reset share-sheet__action {{!timelineShareReady ? 'share-sheet__action--unavailable' : ''}}"
        disabled="{{isPreparingTimelineShare}}"
        bindtap="shareWorkToTimeline"
        aria-label="{{isPreparingTimelineShare ? '作品朋友圈分享准备中' : '将作品分享到朋友圈'}}"
      >
        <image src="/assets/icons/share-timeline-ref.png" mode="aspectFit"></image>
        <text>{{isPreparingTimelineShare ? '朋友圈准备中' : '作品到朋友圈'}}</text>
      </button>
      <button
        class="native-button-reset share-sheet__action {{!posterReady && !posterBackgroundReady ? 'share-sheet__action--unavailable' : ''}}"
        disabled="{{(!posterReady && !posterBackgroundReady) || isPreparingSharePoster}}"
        bindtap="showPosterPreview"
        aria-label="{{posterReady || posterBackgroundReady ? '生成分享海报' : '海报图不可用'}}"
      >
        <image src="/assets/icons/share-poster-ref.png" mode="aspectFit"></image>
        <text>{{!posterReady && !posterBackgroundReady ? '海报图不可用' : isPreparingSharePoster ? '生成中' : '生成分享海报'}}</text>
      </button>
    </view>
    <view wx:if="{{isOwner}}" class="share-sheet__reward">
      <image class="share-sheet__reward-icon" src="/assets/icons/share-reward-plus.png" mode="aspectFit"></image>
      <text>好友成功打开后，你可获得 1 次创作机会</text>
    </view>
    <view wx:else class="share-sheet__reward share-sheet__reward--neutral">
      <image class="share-sheet__reward-icon" src="/assets/icons/share-info.png" mode="aspectFit"></image>
      <text>仅分享自己的作品，好友打开后才会增加创作次数</text>
    </view>
  </view>
</view>

<view wx:if="{{posterPreviewVisible && !isTimelineSinglePage}}" class="share-preview-layer" catchtap="closePosterPreview">
  <view class="share-preview" catchtap="stopShareTap">
    <button class="native-button-reset share-preview__close" bindtap="closePosterPreview" aria-label="关闭海报预览">×</button>
    <swiper
      wx:if="{{posterSharePosterPath && backgroundPosterSharePosterPath}}"
      class="share-preview__swiper"
      current="{{sharePosterIndex}}"
      previous-margin="86rpx"
      next-margin="86rpx"
      duration="280"
      easing-function="easeOutCubic"
      skip-hidden-item-layout="true"
      bindchange="changeSharePoster"
      aria-label="分享海报，可左右滑动切换有字和无字版本"
    >
      <swiper-item>
        <view class="share-preview__slide {{sharePosterIndex === 0 ? 'share-preview__slide--active' : ''}}">
          <image class="share-preview__poster" src="{{posterSharePosterPath}}" mode="widthFix"></image>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="share-preview__slide {{sharePosterIndex === 1 ? 'share-preview__slide--active' : ''}}">
          <image class="share-preview__poster" src="{{backgroundPosterSharePosterPath}}" mode="widthFix"></image>
        </view>
      </swiper-item>
    </swiper>
    <image
      wx:else
      class="share-preview__poster share-preview__poster--single"
      src="{{sharePosterPath}}"
      mode="widthFix"
    ></image>
  </view>
  <view class="share-preview-sheet" catchtap="stopShareTap">
    <view class="share-sheet__actions share-sheet__actions--preview">
      <button wx:if="{{friendShareReady}}" class="native-button-reset share-sheet__action" open-type="share">
        <image src="/assets/icons/share-friend-ref.png" mode="aspectFit"></image>
        <text>微信好友/群聊</text>
      </button>
      <button
        wx:else
        class="native-button-reset share-sheet__action share-sheet__action--unavailable"
        disabled="{{isPreparingFriendShare}}"
        bindtap="retryFriendSharePreparation"
        aria-label="{{isPreparingFriendShare ? '好友和群聊分享准备中' : '重新准备好友和群聊分享'}}"
      >
        <image src="/assets/icons/share-friend-ref.png" mode="aspectFit"></image>
        <text>{{isPreparingFriendShare ? '好友/群聊准备中' : '微信好友/群聊'}}</text>
      </button>
      <button class="native-button-reset share-sheet__action" bindtap="sharePosterToTimeline">
        <image src="/assets/icons/share-timeline-ref.png" mode="aspectFit"></image>
        <text>海报到朋友圈</text>
      </button>
      <button class="native-button-reset share-sheet__action" bindtap="saveSharePoster">
        <view class="share-sheet__save-icon">
          <image src="/assets/icons/share-save.svg" mode="aspectFit"></image>
        </view>
        <text>{{isSavingPoster ? '保存中' : '保存到相册'}}</text>
      </button>
    </view>
    <button class="native-button-reset share-preview-sheet__cancel" bindtap="closePosterPreview">取消</button>
  </view>
</view>

<canvas id="sharePosterCanvas" class="share-poster-canvas" type="2d"></canvas>
</view>
