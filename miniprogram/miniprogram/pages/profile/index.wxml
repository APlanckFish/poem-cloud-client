<view class="app-viewport profile-viewport">
<navigation-bar title="我的" back="{{false}}" color="#202824" background="#fbfaf7"></navigation-bar>

<scroll-view
  class="page-scroll"
  scroll-y
  enhanced
  bounces="{{false}}"
  refresher-enabled="{{false}}"
  show-scrollbar="{{false}}"
>
  <view class="page-content profile-page">
    <view class="identity-section">
      <view class="profile-main {{isLoggedIn ? 'profile-main--logged' : 'profile-main--guest'}}">
        <view class="avatar-shell">
          <image
            wx:if="{{isLoggedIn && displayAvatarUrl}}"
            class="avatar-image"
            src="{{displayAvatarUrl}}"
            mode="aspectFill"
          ></image>
          <view wx:else class="avatar-default">
            <view class="default-head"></view>
            <view class="default-body"></view>
          </view>
        </view>

        <view class="profile-copy">
          <block wx:if="{{isLoggedIn}}">
            <view class="profile-name-row">
              <text class="profile-name poem-display">{{user.nickname}}</text>
              <view
                class="profile-edit-button"
                bindtap="openProfileSetup"
                hover-class="profile-edit-button--pressed"
                aria-role="button"
                aria-label="编辑个人资料"
              >
                <image class="edit-mark" src="/assets/icons/common-edit.svg" mode="aspectFit"></image>
              </view>
            </view>
            <view class="account-tag {{isLevelZeroVip ? 'account-tag--black-gold' : ''}}">
              <text class="account-tag__copy">{{rankLabel}}</text>
            </view>
          </block>
          <block wx:else>
            <text class="profile-name poem-display">诗云访客</text>
            <text class="profile-subtitle">登录后同步作品与草稿</text>
            <view
              class="login-button {{isLoggingIn ? 'login-button--disabled' : ''}}"
              bindtap="handleLogin"
              hover-class="login-button--pressed"
              aria-role="button"
              aria-label="登录"
              aria-disabled="{{isLoggingIn}}"
            >登录</view>
          </block>
        </view>

        <view
          wx:if="{{isLoggedIn}}"
          class="logout-button"
          bindtap="handleLogout"
          hover-class="logout-button--pressed"
          aria-role="button"
          aria-label="登出当前账号"
        >登出</view>
      </view>

      <view wx:if="{{isLoggedIn}}" class="stats-row">
        <view
          class="stat-item"
          data-key="works"
          bindtap="handleMenu"
          hover-class="stat-item--pressed"
          aria-role="button"
          aria-label="查看我的作品"
        >
          <text class="stat-value poem-display">{{isLoggedIn ? stats.works : '—'}}</text>
          <text class="stat-label">作品</text>
        </view>
        <view class="stat-divider"></view>
        <view
          class="stat-item"
          data-key="drafts"
          bindtap="handleMenu"
          hover-class="stat-item--pressed"
          aria-role="button"
          aria-label="查看我的草稿"
        >
          <text class="stat-value poem-display">{{isLoggedIn ? stats.drafts : '—'}}</text>
          <text class="stat-label">草稿</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value poem-display">{{isLoggedIn ? stats.likes : '—'}}</text>
          <text class="stat-label">获赞</text>
        </view>
        <view class="stat-divider"></view>
        <view
          class="stat-item"
          data-key="followers"
          bindtap="handleMenu"
          hover-class="stat-item--pressed"
          aria-role="button"
          aria-label="查看我的粉丝"
        >
          <text class="stat-value poem-display">{{isLoggedIn ? stats.followers : '—'}}</text>
          <text class="stat-label">粉丝</text>
        </view>
      </view>
    </view>

    <view class="quota-card {{isLevelZeroVip ? 'quota-card--black-gold' : ''}} {{quotaLoaded && !quota.unlimited && quota.bonusLimit > 0 && quota.bonus >= quota.bonusLimit ? 'quota-card--bonus-full' : ''}}">
      <block wx:if="{{isLevelZeroVip}}">
        <view class="vip-copy">
          <view class="vip-eyebrow">
            <text class="vip-eyebrow__mark">SVIP</text>
            <text class="vip-eyebrow__name">诗云黑金会员</text>
          </view>
          <text class="vip-title poem-display">无限创作特权</text>
          <text class="vip-caption">至臻等级 · 尊享不限次数创作</text>
        </view>
        <view class="vip-emblem">
          <text class="vip-emblem__label">SVIP</text>
          <text class="vip-emblem__infinity">∞</text>
        </view>
      </block>
      <block wx:else>
        <view class="quota-copy">
          <view class="quota-heading">
            <text class="quota-label poem-display">今日可创作</text>
            <text wx:if="{{quotaLoaded && quota.bonus > 0}}" class="quota-bonus">分享加成 +{{quota.bonus}}</text>
          </view>
          <view class="quota-value-row">
            <text class="quota-value">{{quotaLoaded ? (quota.unlimited ? '不限' : quota.remaining) : '—'}}</text>
            <text wx:if="{{!quotaLoaded || !quota.unlimited}}" class="quota-unit">次</text>
          </view>
          <text
            wx:if="{{quotaLoaded && !quota.unlimited && quota.bonusLimit > 0 && quota.bonus >= quota.bonusLimit}}"
            class="quota-bonus-full"
          >今日分享加成已满，明日可继续获得</text>
        </view>
        <view class="quota-meter">
          <view class="quota-ring {{quotaRingClass}}">
            <view class="quota-ring__inner">
              <text class="quota-ring__value">{{quotaLoaded ? (quota.unlimited ? '∞' : quota.remaining + '/' + quota.limit) : '—/—'}}</text>
            </view>
          </view>
          <text class="quota-ring__label">{{quotaLoaded ? (quota.unlimited ? '无限创作' : '每日 ' + quota.limit + ' 次') : '正在同步'}}</text>
        </view>
      </block>
    </view>

    <view class="menu-card">
      <view
        wx:for="{{libraryMenus}}"
        wx:key="key"
        class="menu-row"
        data-key="{{item.key}}"
        data-protected="{{item.protected}}"
        bindtap="handleMenu"
        hover-class="menu-row--pressed"
        aria-role="button"
      >
        <image class="menu-icon" src="/assets/icons/menu-{{item.key}}.svg" mode="aspectFit"></image>
        <text class="menu-label">{{item.label}}</text>
        <text wx:if="{{isLoggedIn && item.key === 'works'}}" class="menu-value">{{stats.works}}</text>
        <text wx:if="{{item.key === 'drafts' && (isLoggedIn || stats.drafts > 0)}}" class="menu-value">{{stats.drafts}}</text>
        <text wx:if="{{isLoggedIn && item.key === 'followers'}}" class="menu-value">{{user.followerCount}}</text>
        <text wx:if="{{isLoggedIn && item.key === 'following'}}" class="menu-value">{{user.followingCount}}</text>
        <image class="menu-arrow" src="/assets/icons/common-chevron-right.svg" mode="aspectFit"></image>
      </view>
    </view>

    <view class="menu-card">
      <view
        wx:for="{{accountMenus}}"
        wx:key="key"
        class="menu-row"
        data-key="{{item.key}}"
        data-protected="{{item.protected}}"
        bindtap="handleMenu"
        hover-class="menu-row--pressed"
        aria-role="button"
      >
        <image class="menu-icon" src="/assets/icons/menu-{{item.key}}.svg" mode="aspectFit"></image>
        <text class="menu-label">{{item.label}}</text>
        <image class="menu-arrow" src="/assets/icons/common-chevron-right.svg" mode="aspectFit"></image>
      </view>
    </view>

    <view class="menu-card">
      <view
        wx:for="{{supportMenus}}"
        wx:key="key"
        class="menu-row"
        data-key="{{item.key}}"
        data-protected="{{item.protected}}"
        bindtap="handleMenu"
        hover-class="menu-row--pressed"
        aria-role="button"
      >
        <image class="menu-icon" src="/assets/icons/menu-{{item.key}}.svg" mode="aspectFit"></image>
        <text class="menu-label">{{item.label}}</text>
        <image class="menu-arrow" src="/assets/icons/common-chevron-right.svg" mode="aspectFit"></image>
      </view>
    </view>

  </view>
</scroll-view>

<view wx:if="{{showProfileSetup}}" class="profile-setup-overlay" catchtouchmove="preventMove">
  <view class="profile-setup-dialog">
    <text class="profile-setup-title poem-display">完善微信资料</text>
    <text class="profile-setup-copy poem-display">让诗友更好地认识你</text>

    <button
      class="avatar-picker"
      size="mini"
      open-type="chooseAvatar"
      bindchooseavatar="handleChooseAvatar"
      hover-class="avatar-picker--pressed"
      aria-label="选择微信头像"
    >
      <image
        wx:if="{{pendingAvatarUrl}}"
        class="avatar-picker__image"
        src="{{pendingAvatarUrl}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="avatar-picker__placeholder">
        <view class="avatar-picker__placeholder-head"></view>
        <view class="avatar-picker__placeholder-body"></view>
      </view>
      <view class="avatar-picker__camera">
        <view class="avatar-picker__camera-body">
          <view class="avatar-picker__camera-lens"></view>
        </view>
      </view>
    </button>
    <text class="avatar-picker__label poem-display">点击更换头像</text>

    <view class="nickname-field">
      <text class="nickname-field__label poem-display">昵称</text>
      <view class="nickname-field__control">
        <input
          class="nickname-field__input poem-display"
          type="nickname"
          maxlength="24"
          value="{{pendingNickname}}"
          placeholder="请输入昵称"
          bindinput="handleNicknameInput"
          bindchange="handleNicknameInput"
          bindblur="handleNicknameInput"
        />
      </view>
    </view>

    <view class="profile-setup-actions">
      <view
        class="profile-setup-skip"
        bindtap="handleProfileSetupSkip"
        hover-class="profile-setup-skip--pressed"
        aria-role="button"
        aria-disabled="{{isSavingProfile}}"
      >稍后再说</view>
      <view
        class="profile-setup-save {{isSavingProfile ? 'profile-setup-save--disabled' : ''}}"
        bindtap="handleProfileSetupSave"
        hover-class="profile-setup-save--pressed"
        aria-role="button"
        aria-disabled="{{isSavingProfile}}"
      >{{isSavingProfile ? '保存中…' : '保存资料'}}</view>
    </view>
  </view>
</view>
</view>
