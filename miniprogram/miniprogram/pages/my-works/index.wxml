<view class="app-viewport works-viewport">
<navigation-bar title="{{isViewingOther ? 'TA的作品' : '我的作品'}}" back="{{true}}" loading="{{isLoading}}" color="#1c231f" background="#f6f4f2"></navigation-bar>

<view wx:if="{{isViewingOther && author}}" class="author-profile">
  <view class="author-profile__avatar">
    <image src="{{author.displayAvatarUrl}}" mode="aspectFill"></image>
  </view>
  <view class="author-profile__copy">
    <text class="author-profile__name poem-display">{{author.nickname}}</text>
    <text class="author-profile__signature">{{author.signature || '未留下个性签名'}}</text>
  </view>
</view>

<view wx:elif="{{isViewingOther && !loadError}}" class="author-profile author-profile--loading" aria-label="作者资料加载中">
  <view class="author-profile__avatar author-profile__skeleton"></view>
  <view class="author-profile__copy">
    <view class="author-profile__skeleton author-profile__skeleton--name"></view>
    <view class="author-profile__skeleton author-profile__skeleton--signature"></view>
  </view>
</view>

<view wx:elif="{{!isViewingOther}}" class="filter-tabs">
  <view
    wx:for="{{tabs}}"
    wx:key="code"
    class="filter-tab poem-display {{activeFilter === item.code ? 'filter-tab--active' : ''}}"
    data-code="{{item.code}}"
    bindtap="selectFilter"
    aria-role="button"
  >{{item.label}}</view>
</view>

<scroll-view
  class="works-scroll"
  scroll-y
  enhanced
  bounces="{{false}}"
  refresher-enabled="{{false}}"
  show-scrollbar="{{false}}"
  scroll-into-view="{{worksScrollAnchor}}"
  bindscrolltolower="loadMore"
>
  <view id="works-scroll-top" class="works-scroll__anchor"></view>
  <view wx:if="{{visibleWorks.length > 0}}" class="works-list">
    <view
      wx:for="{{visibleWorks}}"
      wx:key="id"
      class="work-card {{isViewingOther ? 'work-card--public' : ''}}"
      data-publication-id="{{item.publicationId}}"
      bindtap="viewPublicWork"
      aria-role="{{isViewingOther ? 'button' : ''}}"
      aria-label="{{isViewingOther ? '查看作品' + item.title : ''}}"
    >
      <image class="work-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="work-copy">
        <text class="work-title poem-display">{{item.title}}</text>
        <text class="work-description">{{item.description}}</text>
        <text class="work-date">{{item.date}}</text>
        <view
          wx:if="{{!isViewingOther}}"
          class="work-status {{item.stateClass}}"
          data-state="{{item.state}}"
          catchtap="showModerationReason"
          aria-role="{{item.state === 'REJECTED' ? 'button' : ''}}"
          aria-label="{{item.state === 'REJECTED' ? '查看作品下架原因' : item.stateLabel}}"
        >
          <text>{{item.stateLabel}}</text>
          <text wx:if="{{item.state === 'REJECTED'}}" class="work-status__notice">!</text>
        </view>
      </view>
      <view
        wx:if="{{!isViewingOther}}"
        class="more-button"
        data-id="{{item.id}}"
        catchtap="openActions"
        aria-role="button"
        aria-label="作品操作"
      >
        <image src="/assets/icons/action-more.svg" mode="aspectFit"></image>
      </view>
      <image
        wx:else
        class="work-card__chevron"
        src="/assets/icons/common-chevron-right.svg"
        mode="aspectFit"
      ></image>
    </view>
    <image class="mountain-wash" src="/assets/images/mountain-wash.jpg" mode="widthFix"></image>
  </view>

  <view wx:elif="{{loadError && !isLoading}}" class="empty-state empty-state--error">
    <text class="empty-title poem-display">作品加载失败</text>
    <text class="empty-copy">{{loadError}}</text>
    <view class="empty-primary empty-primary--outline poem-display" bindtap="retryLoad" aria-role="button">重新加载</view>
    <image class="empty-mountain" src="/assets/images/mountain-wash.jpg" mode="widthFix"></image>
  </view>

  <view wx:elif="{{hasLoaded && !isLoading}}" class="empty-state">
    <image class="empty-illustration empty-illustration--works" src="/assets/images/empty-works.jpg" mode="aspectFit"></image>
    <text class="empty-title poem-display">{{isViewingOther ? '还没有公开作品' : '还没有作品'}}</text>
    <text class="empty-copy">{{isViewingOther ? '作者发布的作品会陈列在这里' : '完成一次创作后，作品会收藏在这里'}}</text>
    <view wx:if="{{!isViewingOther}}" class="empty-primary poem-display" bindtap="startCreating" aria-role="button">去创作</view>
    <image class="empty-mountain" src="/assets/images/mountain-wash.jpg" mode="widthFix"></image>
  </view>
</scroll-view>

<view wx:if="{{actionWork}}" class="sheet-overlay" catchtouchmove="preventMove" bindtap="closeActions">
  <view class="sheet-stack" catchtap="preventMove">
    <view class="action-sheet">
      <view class="sheet-heading">
        <image class="sheet-cover" src="{{actionWork.cover}}" mode="aspectFill"></image>
        <text class="sheet-title poem-display">{{actionWork.title}}</text>
      </view>

      <view class="sheet-action" bindtap="viewWork">
        <image src="/assets/icons/action-eye.svg" mode="aspectFit"></image>
        <text class="poem-display">查看作品</text>
      </view>
      <view
        wx:if="{{actionWork.state === 'UNPUBLISHED' || actionWork.state === 'HIDDEN'}}"
        class="sheet-action"
        bindtap="publishWork"
      >
        <image src="/assets/icons/tab-community-active.svg" mode="aspectFit"></image>
        <text class="poem-display">发布到诗词圈</text>
      </view>
      <view
        wx:if="{{actionWork.state === 'PUBLISHED'}}"
        class="sheet-action"
        bindtap="changeVisibility"
      >
        <image src="/assets/icons/action-lock.svg" mode="aspectFit"></image>
        <text class="poem-display">设为仅自己可见</text>
      </view>
      <view class="sheet-action sheet-action--danger" bindtap="confirmDelete">
        <image src="/assets/icons/action-trash.svg" mode="aspectFit"></image>
        <text class="poem-display">删除作品</text>
      </view>
    </view>
    <view class="sheet-cancel poem-display" bindtap="closeActions">取消</view>
  </view>
</view>
</view>
