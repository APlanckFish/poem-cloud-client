<view class="app-viewport social-viewport">
<navigation-bar title="我的粉丝" back="{{true}}" loading="{{isLoading}}" color="#161c19" background="#fbfaf7"></navigation-bar>

<scroll-view class="social-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}" bindscrolltolower="loadMore">
  <view class="social-page {{hasLoaded && items.length === 0 ? 'social-page--empty' : ''}}">
    <view class="social-hero social-hero--followers">
      <image
        class="hero-art"
        style="position:absolute;top:0;left:0;width:750rpx;height:272rpx;"
        src="/assets/images/social-followers-hero-v6.png"
        mode="scaleToFill"
      ></image>
      <view class="hero-avatar">
        <image wx:if="{{user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <image wx:else src="/assets/images/cover-ridge.jpg" mode="aspectFill"></image>
      </view>
      <view class="hero-copy">
        <view class="hero-number-line poem-display">
          <text class="hero-number">{{user.followerCount}}</text>
          <text class="hero-unit">人</text>
        </view>
        <view class="hero-caption-line">
          <text class="hero-caption">关注你的人</text>
          <view class="hero-cloud-line"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{items.length > 0}}" class="social-list">
      <view wx:for="{{items}}" wx:key="id" class="person-card">
        <view class="person-avatar">
          <image src="{{item.displayAvatarUrl}}" mode="aspectFill"></image>
        </view>
        <view class="person-copy">
          <text class="person-name poem-display">{{item.nickname}}</text>
          <text class="person-signature">{{item.signature || '这个人很神秘，什么都没有留下'}}</text>
        </view>
        <view
          class="follow-button poem-display {{item.followedByMe ? 'follow-button--mutual' : 'follow-button--primary'}} {{operatingId === item.id ? 'follow-button--busy' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleFollow"
          aria-role="button"
          aria-disabled="{{operatingId === item.id}}"
        >{{item.followedByMe ? '互相关注' : '回关'}}</view>
      </view>
    </view>

    <view wx:elif="{{hasLoaded && !isLoading}}" class="social-empty">
      <image class="empty-illustration" src="/assets/images/empty-followers-v4.png" mode="aspectFit"></image>
      <text class="empty-title poem-display">暂无粉丝</text>
      <text class="empty-copy">发布你的诗作，让更多诗友认识你</text>
      <view class="empty-outline poem-display" bindtap="startCreating" aria-role="button">开始创作</view>
    </view>
  </view>
</scroll-view>
</view>
