<view class="tab-bar {{skylineMode ? 'tab-bar--skyline' : ''}}" catchtap="preventTouch">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'tab-item--active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    catchtap="switchTab"
    hover-class="tab-item--pressed"
    aria-role="button"
    aria-label="{{item.text}}"
  >
    <image
      class="tab-icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
      mode="aspectFit"
    ></image>
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
